# ============================================================================
# Aurelia — Client-Side Environment Configuration
# Copy this file to `.env.local` (or `.env`) and populate with your credentials.
# Never commit real credentials to version control.
# ============================================================================

# --- Primary Provider: YouTube Music / Google Cloud Console ---
# OAuth 2.0 Web Client ID (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=

# YouTube Data API v3 Key
VITE_GOOGLE_API_KEY=

# --- Secondary Provider: Spotify (Optional / Deferred) ---
# Spotify Developer Application Client ID (PKCE Flow)
VITE_SPOTIFY_CLIENT_ID=

# OAuth Redirect URI registered in your Spotify App settings
VITE_SPOTIFY_REDIRECT_URI=
